generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  website   String?
  createdAt DateTime @default(now())
  jobs      Job[]
}

model Job {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  location    String
  remote      Boolean  @default(false)
  salary      Int?
  createdAt   DateTime @default(now())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id])
}
